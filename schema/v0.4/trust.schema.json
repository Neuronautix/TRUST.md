{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Neuronautix/TRUST.md/v0.4.0-rc.1/schema/v0.4/trust.schema.json",
  "title": "TRUST.md v0.4 YAML front matter",
  "type": "object",
  "required": ["trust_md_version", "title", "description", "canonical", "license", "companions", "produced_by", "governance", "epistemic_model", "subjects", "last_reviewed"],
  "properties": {
    "trust_md_version": {"const": "0.4"},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "canonical": {"$ref": "#/$defs/httpUri"},
    "license": {"type": "string", "minLength": 1},
    "companions": {
      "type": "object",
      "properties": {
        "fair": {"$ref": "#/$defs/companion"},
        "inline_markup_spec": {"$ref": "#/$defs/companion"},
        "claim_records": {"$ref": "#/$defs/companion"}
      },
      "additionalProperties": {"$ref": "#/$defs/companion"}
    },
    "produced_by": {
      "type": "object",
      "required": ["humans", "agents"],
      "properties": {
        "humans": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/human"}},
        "agents": {"type": "array", "items": {"$ref": "#/$defs/agent"}}
      }
    },
    "governance": {
      "type": "object",
      "required": ["source_of_truth", "no_fabricated_citations", "review_policy", "correction_policy", "conflict_of_interest"],
      "properties": {
        "source_of_truth": {"type": "string", "minLength": 1},
        "no_fabricated_citations": {"type": "boolean"},
        "review_policy": {"type": "string", "minLength": 1},
        "correction_policy": {"type": "string", "minLength": 1},
        "conflict_of_interest": {"type": "string", "minLength": 1}
      }
    },
    "epistemic_model": {
      "type": "object",
      "required": ["categories", "support_bands"],
      "properties": {
        "categories": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/category"}},
        "support_bands": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {"$ref": "#/$defs/supportBand"}
        },
        "confidence_scale": {
          "type": "object",
          "required": ["type", "range", "independent_of_category", "not_probability"],
          "properties": {
            "type": {"const": "integer"},
            "range": {"const": [0, 100]},
            "independent_of_category": {"const": true},
            "not_probability": {"const": true}
          }
        },
        "encoding": {
          "type": "object",
          "properties": {
            "inline": {"type": "string", "minLength": 1},
            "reader_tooling": {"type": "string", "minLength": 1}
          }
        },
        "alignment": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/subject"}
    },
    "assessments": {
      "type": "array",
      "items": {"$ref": "#/$defs/assessment"}
    },
    "impact": {
      "type": "object",
      "properties": {
        "citations": {"type": "integer", "minimum": 0},
        "downloads": {"type": "integer", "minimum": 0},
        "reuse_count": {"type": "integer", "minimum": 0},
        "measured_at": {"$ref": "#/$defs/offsetDateTime"},
        "source": {"$ref": "#/$defs/httpUri"}
      }
    },
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "last_reviewed": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
  },
  "$defs": {
    "httpUri": {"type": "string", "format": "uri", "pattern": "^https?://"},
    "offsetDateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "companion": {"oneOf": [{"type": "string", "pattern": "^/"}, {"type": "null"}]},
    "human": {
      "type": "object",
      "required": ["name", "role"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "orcid": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9X]$"},
        "org": {"type": "string"}
      }
    },
    "agent": {
      "type": "object",
      "required": ["name", "role", "oversight"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "oversight": {"enum": ["human-reviewed", "human-in-the-loop", "automated", "none"]}
      }
    },
    "category": {
      "type": "object",
      "required": ["id", "label", "definition"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]+$"},
        "label": {"type": "string", "minLength": 1},
        "definition": {"type": "string", "minLength": 1}
      }
    },
    "bandName": {"enum": ["speculative", "tentative", "moderate", "high", "very-high"]},
    "supportBand": {
      "type": "object",
      "required": ["id", "label", "meaning"],
      "properties": {
        "id": {"$ref": "#/$defs/bandName"},
        "label": {"type": "string", "minLength": 1},
        "meaning": {"type": "string", "minLength": 1},
        "range": {"type": "string", "pattern": "^[0-9]+-[0-9]+$"}
      }
    },
    "digest": {
      "type": "object",
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {"enum": ["sha-256", "sha-384", "sha-512"]},
        "value": {"type": "string"}
      },
      "oneOf": [
        {"properties": {"algorithm": {"const": "sha-256"}, "value": {"pattern": "^[0-9a-fA-F]{64}$"}}},
        {"properties": {"algorithm": {"const": "sha-384"}, "value": {"pattern": "^[0-9a-fA-F]{96}$"}}},
        {"properties": {"algorithm": {"const": "sha-512"}, "value": {"pattern": "^[0-9a-fA-F]{128}$"}}}
      ]
    },
    "snapshot": {
      "type": "object",
      "required": ["identifier", "digest"],
      "properties": {
        "identifier": {"$ref": "#/$defs/httpUri"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "subject": {
      "type": "object",
      "required": ["id", "type", "identifier"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"},
        "type": {"type": "string", "pattern": "^(repository|artifact|claim|claim-evidence|evidence-record|x_[A-Za-z0-9._-]+)$"},
        "identifier": {"$ref": "#/$defs/httpUri"},
        "version": {"type": "string", "minLength": 1},
        "snapshot": {"$ref": "#/$defs/snapshot"}
      },
      "oneOf": [
        {"required": ["version"], "not": {"required": ["snapshot"]}},
        {"required": ["snapshot"], "not": {"required": ["version"]}}
      ]
    },
    "missingState": {"enum": ["not-assessed", "not-applicable"]},
    "dimensions": {
      "type": "object",
      "properties": {
        "evidence_support": {"oneOf": [{"enum": ["none", "contested", "partial", "indirect", "direct"]}, {"$ref": "#/$defs/missingState"}]},
        "calibration": {"enum": ["understated", "matched", "overstated", "not-assessed", "not-applicable"]},
        "source_integrity": {"enum": ["unverified", "partially-verified", "verified", "not-assessed", "not-applicable"]}
      }
    },
    "numericRefinement": {
      "type": "object",
      "required": ["value", "not_probability"],
      "properties": {
        "value": {"type": "integer", "minimum": 0, "maximum": 100},
        "not_probability": {"const": true}
      }
    },
    "protocol": {
      "type": "object",
      "required": ["identifier", "version"],
      "properties": {
        "identifier": {"$ref": "#/$defs/httpUri"},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "basis": {
      "type": "object",
      "required": ["relation", "identifier"],
      "properties": {
        "relation": {
          "oneOf": [
            {"enum": ["informed-by", "uses-qc-report", "checked-against", "derived-from"]},
            {"type": "string", "pattern": "^x_[A-Za-z0-9._-]+$"}
          ]
        },
        "identifier": {"$ref": "#/$defs/httpUri"},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "bandCounts": {
      "type": "object",
      "properties": {
        "speculative": {"type": "integer", "minimum": 0},
        "tentative": {"type": "integer", "minimum": 0},
        "moderate": {"type": "integer", "minimum": 0},
        "high": {"type": "integer", "minimum": 0},
        "very-high": {"type": "integer", "minimum": 0}
      }
    },
    "assessmentSummary": {
      "type": "object",
      "required": ["scope"],
      "properties": {
        "scope": {"const": "assessment"},
        "band_distribution": {"$ref": "#/$defs/bandCounts"},
        "median_band": {"$ref": "#/$defs/bandName"}
      }
    },
    "assessment": {
      "type": "object",
      "required": ["series_id", "id", "version", "subject", "assessed_by", "protocol", "assessed_at", "review_status", "independence", "status", "limitations"],
      "properties": {
        "series_id": {"$ref": "#/$defs/httpUri"},
        "id": {"$ref": "#/$defs/httpUri"},
        "version": {"type": "string", "minLength": 1},
        "subject": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "fitness_for_purpose": {"enum": ["suitable", "conditionally-suitable", "not-suitable", "not-assessed", "not-applicable"]},
        "conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "dimensions": {"$ref": "#/$defs/dimensions"},
        "numeric_refinement": {"$ref": "#/$defs/numericRefinement"},
        "assessed_by": {
          "type": "object",
          "required": ["humans", "agents"],
          "properties": {
            "humans": {"type": "array", "items": {"$ref": "#/$defs/human"}},
            "agents": {"type": "array", "items": {"$ref": "#/$defs/agent"}}
          }
        },
        "protocol": {"$ref": "#/$defs/protocol"},
        "evidence_basis": {"type": "array", "items": {"$ref": "#/$defs/basis"}},
        "assessed_at": {"$ref": "#/$defs/offsetDateTime"},
        "assessed_at_precision": {"enum": ["date", "datetime"]},
        "review_status": {"enum": ["unreviewed", "agent-reviewed", "human-reviewed", "adjudicated"]},
        "independence": {"enum": ["not-declared", "declared-not-independent", "declared-partially-independent", "declared-independent"]},
        "status": {"enum": ["active", "superseded", "withdrawn", "retracted"]},
        "supersedes": {"$ref": "#/$defs/httpUri"},
        "lifecycle_reason": {"type": "string", "minLength": 1},
        "disagreement": {"$ref": "#/$defs/httpUri"},
        "resolution": {"$ref": "#/$defs/httpUri"},
        "summary": {"$ref": "#/$defs/assessmentSummary"},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "allOf": [
        {
          "if": {"required": ["fitness_for_purpose"]},
          "then": {"required": ["purpose"]}
        },
        {
          "if": {"properties": {"fitness_for_purpose": {"const": "conditionally-suitable"}}, "required": ["fitness_for_purpose"]},
          "then": {"required": ["conditions"]}
        },
        {
          "if": {"properties": {"status": {"const": "active"}, "review_status": {"enum": ["agent-reviewed", "human-reviewed", "adjudicated"]}}, "required": ["status", "review_status"]},
          "then": {"properties": {"evidence_basis": {"minItems": 1}}, "required": ["evidence_basis"]}
        },
        {
          "if": {"properties": {"review_status": {"enum": ["human-reviewed", "adjudicated"]}}, "required": ["review_status"]},
          "then": {"properties": {"assessed_by": {"properties": {"humans": {"minItems": 1}}}}}
        },
        {
          "if": {"properties": {"review_status": {"const": "adjudicated"}}, "required": ["review_status"]},
          "then": {"required": ["disagreement", "resolution"]}
        },
        {
          "if": {"properties": {"status": {"enum": ["superseded", "withdrawn", "retracted"]}}, "required": ["status"]},
          "then": {"required": ["supersedes", "lifecycle_reason"]}
        }
      ]
    }
  }
}
